NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# URL pública do site (sem barra final) — Open Graph, canonical, JSON-LD, sitemap.xml e robots.txt
# Em produção: https://seudominio.com
NEXT_PUBLIC_SITE_URL=https://dezzapego.com

# O comando `npm run generate:sitemap` (e o build) usa NEXT_PUBLIC_SUPABASE_* para listar todos os /anuncio/:id

# Pesquisa orgânica (Google): após registrar no Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=conteudo_da_meta

# Opcional — imagem de compartilhamento recomendada 1200x630 JPG/PNG na pasta public
NEXT_PUBLIC_OG_IMAGE=/og-default.png
NEXT_PUBLIC_OG_IMAGE_WIDTH=1200
NEXT_PUBLIC_OG_IMAGE_HEIGHT=630

# JSON-LD Organization: logo e redes (URLs completas, redes separadas por vírgula)
# NEXT_PUBLIC_ORG_LOGO_URL=/icon.svg
# NEXT_PUBLIC_ORG_SAME_AS=https://www.instagram.com/sua_conta

# Google AdSense (público, não é segredo). Só habilita se preenchido.
# O NEXT_PUBLIC_ADSENSE_CLIENT também injeta a meta de verificação google-adsense-account no HTML inicial.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7650087188632188
# NEXT_PUBLIC_ADSENSE_HOME_TOP_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_HOME_MOBILE_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_AD_DETAIL_TOP_SLOT=1234567890
# Ative em homologação/preview para evitar impressões inválidas; em dev local já fica ligado automaticamente.
# NEXT_PUBLIC_ADSENSE_TEST_MODE=true

# Pagamentos de anúncios em destaque (somente no ambiente serverless/API)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PIXGO_API_KEY=pk_xxx
PIXGO_WEBHOOK_SECRET=whsec_xxx

# Cloudflare Turnstile Site Key (Chave pública)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
