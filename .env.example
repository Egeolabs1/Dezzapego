VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# URL pública do site (sem barra final) — Open Graph, canonical, JSON-LD, sitemap.xml e robots.txt
# Em produção: https://seudominio.com
VITE_SITE_URL=https://dezzapego.com

# O comando `npm run generate:sitemap` (e o build) usam também VITE_SUPABASE_* para listar todos os /anuncio/:id

# Pesquisa orgânica (Google): após registrar no Search Console
# VITE_GOOGLE_SITE_VERIFICATION=conteudo_da_meta

# Opcional — imagem de compartilhamento recomendada 1200x630 JPG/PNG na pasta public
# VITE_OG_IMAGE=/og-1200x630.png
# VITE_OG_IMAGE_WIDTH=1200
# VITE_OG_IMAGE_HEIGHT=630

# JSON-LD Organization: logo e redes (URLs completas, redes separadas por vírgula)
# VITE_ORG_LOGO_URL=/icon.svg
# VITE_ORG_SAME_AS=https://www.instagram.com/sua_conta
